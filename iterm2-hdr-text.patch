index e50ef46f3..84a80f8ae 100644
--- a/sources/Drawing/iTermTextDrawingHelper.m
+++ b/sources/Drawing/iTermTextDrawingHelper.m
@@ -8,6 +8,9 @@
 
 #import "iTermTextDrawingHelper.h"
 
+#import <dlfcn.h>
+#import <objc/message.h>
+
 #import "charmaps.h"
 #import "CVector.h"
 #import "DebugLogging.h"
@@ -4830,3 +4833,113 @@ typedef struct {
 }
 
 @end
+
+#pragma mark - Night Shift
+
+// Lives here (an ARC file) rather than in iTermCursor.m, which is built without ARC.
+NSNotificationName const iTermNightShiftDidChangeNotification = @"iTermNightShiftDidChangeNotification";
+
+@interface iTermNightShiftMonitor()
+- (void)refresh;
+@end
+
+@implementation iTermNightShiftMonitor {
+    id _client;
+    BOOL _active;
+    NSTimer *_pollTimer;
+}
+
++ (instancetype)sharedInstance {
+    static iTermNightShiftMonitor *instance;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        instance = [[self alloc] init];
+    });
+    return instance;
+}
+
+- (instancetype)init {
+    self = [super init];
+    if (self) {
+        // CoreBrightness is a private framework, so load it and look the class
+        // up at runtime. Everything below degrades to "Night Shift is off" if it
+        // is unavailable.
+        dlopen("/System/Library/PrivateFrameworks/CoreBrightness.framework/CoreBrightness", RTLD_LAZY);
+        Class clientClass = NSClassFromString(@"CBBlueLightClient");
+        if (clientClass) {
+            _client = [[clientClass alloc] init];
+        }
+        _active = [self readActive];
+        DLog(@"Night Shift monitor started. client=%@ active=%@", _client, @(_active));
+
+        __weak __typeof(self) weakSelf = self;
+        SEL notificationSelector = NSSelectorFromString(@"setStatusNotificationBlock:");
+        if (_client && [_client respondsToSelector:notificationSelector]) {
+            void (^block)(void) = ^{
+                // Called on a CoreBrightness queue.
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    [weakSelf refresh];
+                });
+            };
+            ((void (*)(id, SEL, id))objc_msgSend)(_client, notificationSelector, block);
+        }
+        // The status block is private API, so also poll slowly and re-check on
+        // wake in case it stops firing on some macOS version.
+        dispatch_async(dispatch_get_main_queue(), ^{
+            __strong __typeof(self) strongSelf = weakSelf;
+            if (!strongSelf || !strongSelf->_client) {
+                return;
+            }
+            strongSelf->_pollTimer = [NSTimer scheduledTimerWithTimeInterval:60
+                                                                     repeats:YES
+                                                                       block:^(NSTimer * _Nonnull timer) {
+                [weakSelf refresh];
+            }];
+            [[[NSWorkspace sharedWorkspace] notificationCenter] addObserver:strongSelf
+                                                                   selector:@selector(refresh)
+                                                                       name:NSWorkspaceDidWakeNotification
+                                                                     object:nil];
+        });
+    }
+    return self;
+}
+
+- (BOOL)active {
+    return _active;
+}
+
+// Reads CBBlueLightClient's status. The struct is private and starts with two
+// one-byte BOOLs. The first stays set whenever a Night Shift schedule is
+// configured, even at midday, so it cannot be used. The second is set only while
+// Night Shift is actually on (scheduled or manual), and is the only field read
+// here. The buffer is much larger than the struct so a future layout that grows
+// cannot write past it.
+- (BOOL)readActive {
+    if (!_client) {
+        return NO;
+    }
+    SEL statusSelector = NSSelectorFromString(@"getBlueLightStatus:");
+    if (![_client respondsToSelector:statusSelector]) {
+        return NO;
+    }
+    uint64_t buffer[32];
+    memset(buffer, 0, sizeof(buffer));
+    const BOOL ok = ((BOOL (*)(id, SEL, void *))objc_msgSend)(_client, statusSelector, buffer);
+    if (!ok) {
+        return NO;
+    }
+    return ((const unsigned char *)buffer)[1] != 0;
+}
+
+- (void)refresh {
+    const BOOL active = [self readActive];
+    if (active == _active) {
+        return;
+    }
+    DLog(@"Night Shift active changed to %@", @(active));
+    _active = active;
+    [[NSNotificationCenter defaultCenter] postNotificationName:iTermNightShiftDidChangeNotification
+                                                        object:nil];
+}
+
+@end
