+// Builds the HDR text checkbox and slider in the empty space to the right of the
+// HDR cursor checkbox and slider, mirroring their layout. The pane uses fixed
+// frames, so position them from the HDR cursor controls' frames.
+- (void)installHDRTextControls {
+    NSView *container = _hdrCursor.superview;
+    if (!container || _hdrText) {
+        return;
+    }
+    const CGFloat gap = 8;
+    const NSRect cursorCheckboxFrame = _hdrCursor.frame;
+    const CGFloat x = NSMaxX(cursorCheckboxFrame) + gap;
+    const CGFloat width = MAX(120, NSWidth(container.bounds) - x);
+
+    // Same class the xib uses for its checkboxes; looked up by name so this does
+    // not depend on how the Swift class is exposed to Objective-C.
+    Class checkboxClass = NSClassFromString(@"iTermSettingsCheckbox") ?: [NSButton class];
+    NSButton *checkbox = [[checkboxClass alloc] initWithFrame:NSMakeRect(x,
+                                                                         NSMinY(cursorCheckboxFrame),
+                                                                         width,
+                                                                         NSHeight(cursorCheckboxFrame))];
+    [checkbox setButtonType:NSButtonTypeSwitch];
+    checkbox.title = NSLocalizedStringWithDefaultValue(@"ProfilesColors.HDRText", nil, [NSBundle mainBundle], @"HDR text in focused pane", @"Checkbox title: draw the focused pane's text brighter than white on HDR displays");
+    checkbox.font = [NSFont systemFontOfSize:[NSFont systemFontSize]];
+    checkbox.toolTip = NSLocalizedStringWithDefaultValue(@"ProfilesColors.HDRTextToolTip", nil, [NSBundle mainBundle], @"When enabled, and when the current display can use HDR (High Dynamic Range), text in the focused pane is drawn brighter than any white that normally appears in an application. Only applies over a dark background and with the GPU renderer. Turned off while Night Shift is on unless changed in Advanced settings.", @"Tooltip for the HDR text checkbox");
+    checkbox.autoresizingMask = NSViewMaxXMargin | NSViewMinYMargin;
+    checkbox.target = self;
+    checkbox.action = @selector(settingChanged:);
+    [container addSubview:checkbox];
+    _hdrText = checkbox;
+
+    // Match the HDR cursor slider's vertical position and size, indented under
+    // the new checkbox the same way the cursor slider is indented under its own.
+    const NSRect cursorSliderFrame = [container convertRect:_hdrCursorBrightness.bounds
+                                                   fromView:_hdrCursorBrightness];
+    const CGFloat indent = NSMinX(cursorSliderFrame) - NSMinX(cursorCheckboxFrame);
+    const CGFloat sliderX = x + MAX(0, indent);
+    const CGFloat sliderWidth = MIN(NSWidth(cursorSliderFrame), NSWidth(container.bounds) - sliderX);
+    NSSlider *slider = [[NSSlider alloc] initWithFrame:NSMakeRect(sliderX,
+                                                                  NSMinY(cursorSliderFrame),
+                                                                  MAX(80, sliderWidth),
+                                                                  NSHeight(cursorSliderFrame))];
+    slider.minValue = iTermHDRTextMinimumBrightness;
+    slider.maxValue = iTermHDRTextMaximumBrightness;
+    // Half steps from the minimum to the maximum.
+    slider.numberOfTickMarks = (NSInteger)round((iTermHDRTextMaximumBrightness - iTermHDRTextMinimumBrightness) / 0.5) + 1;
+    slider.allowsTickMarkValuesOnly = YES;
+    slider.tickMarkPosition = NSTickMarkPositionAbove;
+    slider.continuous = YES;
+    slider.doubleValue = iTermHDRTextDefaultBrightness;
+    slider.toolTip = NSLocalizedStringWithDefaultValue(@"ProfilesColors.HDRTextBrightnessToolTip", nil, [NSBundle mainBundle], @"Brightness of HDR text, as a multiple of normal white. Dim colors get brighter by the same factor. The display shows at most what its HDR headroom allows.", @"Tooltip for the HDR text brightness slider");
+    slider.autoresizingMask = NSViewMaxXMargin | NSViewMinYMargin;
+    slider.target = self;
+    slider.action = @selector(settingChanged:);
+    [container addSubview:slider];
+    _hdrTextBrightness = slider;
+}
